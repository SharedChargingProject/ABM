flowchart TD
    subgraph Setup["System Initialization"]
        A1[Create SimPy Environment] --> A2[Create EnergySandbox]
        A2 --> A3[Create Environment Wrapper]
        A3 --> A4[Create ChargingColumns]
        A4 --> A5[Start ChargingColumn.main_loop processes]
        A5 --> A6[Create Vehicles with random params]
        A6 --> A7[Start Vehicle.plug_in processes]
        A7 --> A8[Run Simulation]
    end

    subgraph VehicleFlow["Vehicle Process Flow"]
        V1([Vehicle Arrives]) --> V2{Enter Delay?}
        V2 -->|Yes| V3[Wait enter_delay]
        V2 -->|No| V4[Search for ChargingColumn]
        V3 --> V4
        V4 --> V5{Free Port<br/>Available?}
        V5 -->|No| V6[Wait 1 sec]
        V6 --> V7{Wait Time<br/>Exceeded?}
        V7 -->|Yes| V8([Leave Unserved])
        V7 -->|No| V5
        V5 -->|Yes| V9[Select Column with Most Free Ports]
        V9 --> V10[Request Column Resource]
        V10 --> V11{Resource<br/>Acquired?}
        V11 -->|Timeout| V12([Leave - Wait Time Exceeded])
        V11 -->|Success| V13[Signal: arrival_event.succeed]
        V13 --> V14[Wait for charge_cmpt_event OR park_end]
        V14 --> V15{Charging<br/>Complete?}
        V15 -->|Yes| V16[Signal: request_disconnect.succeed]
        V15 -->|No - Park End| V16
        V16 --> V17[Wait for request_disconnect_approved]
        V17 --> V18[Release Column Resource]
        V18 --> V19([Vehicle Leaves])
    end

    subgraph ChargingColumnFCFS["ChargingColumn - FCFS Strategy"]
        C1{Any Connected<br/>EVs?} -->|No| C2[Wait for arrival_event]
        C2 --> C1
        C1 -->|Yes| C3[Select EV with Earliest assign_time]
        C3 --> C4{EV Already<br/>Disconnected?}
        C4 -->|Yes| C5[Wait 60 sec]
        C5 --> C1
        C4 -->|No| C6[Set as active_ev]
        C6 --> C7[Handle Handshake]
        C7 --> C8{Handshake<br/>Success?}
        C8 -->|No| C9[Wait 60 sec]
        C9 --> C1
        C8 -->|Yes| C10{EV Needs<br/>Energy?}
        C10 -->|No| C11[Signal: charge_cmpt_event.succeed]
        C11 --> C12[Signal: request_disconnect_approved.succeed]
        C12 --> C13[Break Handshakes]
        C13 --> C1
        C10 -->|Yes| C14[Calculate Power & Energy for Window]
        C14 --> C15{Need More<br/>Power?}
        C15 -->|Yes| C16[Request Power from EnergySandbox]
        C16 --> C17{Power<br/>Granted?}
        C17 -->|No - EV Disconnect| C18[Cancel Power Request]
        C18 --> C12
        C17 -->|Yes| C19[Add to current_consumption]
        C15 -->|No| C19
        C19 --> C20[Charge for Duration OR Until request_disconnect]
        C20 --> C21[Deliver Energy to EV]
        C21 --> C22[Log Energy & Cost]
        C22 --> C23{EV Requested<br/>Disconnect?}
        C23 -->|Yes| C12
        C23 -->|No| C10
    end

    subgraph ChargingColumnSHRD["ChargingColumn - SHRD Strategy"]
        S1{Any Connected<br/>EVs?} -->|No| S2[Wait for arrival_event]
        S2 --> S1
        S1 -->|Yes| S3[Select EV with Oldest last_charge_time]
        S3 --> S4{EV Already<br/>Disconnected?}
        S4 -->|Yes| S5[Wait 60 sec]
        S5 --> S1
        S4 -->|No| S6[Update last_charge_time]
        S6 --> S7[Handle Handshake]
        S7 --> S8{Handshake<br/>Success?}
        S8 -->|No| S9[Wait 60 sec]
        S9 --> S1
        S8 -->|Yes| S10{EV Needs<br/>Energy?}
        S10 -->|No| S11[Signal: charge_cmpt_event.succeed]
        S11 --> S12[Signal: request_disconnect_approved.succeed]
        S12 --> S1
        S10 -->|Yes| S13[Calculate Power & Energy for Window]
        S13 --> S14{Need More<br/>Power?}
        S14 -->|Yes| S15[Request Power from EnergySandbox]
        S15 --> S16{Power<br/>Granted?}
        S16 -->|No - EV Disconnect| S17[Cancel/Release Power]
        S17 --> S18[Wait 60 sec]
        S18 --> S1
        S16 -->|Yes| S19[Add to current_consumption]
        S14 -->|No| S19
        S19 --> S20[Charge for Duration OR Until request_disconnect]
        S20 --> S21[Deliver Energy to EV]
        S21 --> S22{Energy<br/>Sufficient?}
        S22 -->|Yes| S23[Signal: charge_cmpt_event.succeed]
        S23 --> S24[Break Handshakes]
        S24 --> S12
        S22 -->|No - Disconnect?| S25{EV Requested<br/>Disconnect?}
        S25 -->|Yes| S24
        S25 -->|No| S1
    end

    subgraph HandshakeProcess["Handshake Process"]
        H1{Already<br/>Handshaked?} -->|Yes| H2[Short Delay]
        H1 -->|No| H3[Break Other Handshakes]
        H3 --> H4[Release Current Power]
        H4 --> H5[Wait handshake_duration OR request_disconnect]
        H5 --> H6{EV Requested<br/>Disconnect?}
        H6 -->|Yes| H7[Signal: request_disconnect_approved.succeed]
        H7 --> H8([Exit - No Handshake])
        H6 -->|No| H9[Set handshake = True]
        H9 --> H2
        H2 --> H10([Handshake Complete])
    end

    subgraph EnergySandboxFlow["EnergySandbox - Power Management"]
        E1[Request Power] --> E2[Container.get power_kw]
        E2 --> E3{Power<br/>Available?}
        E3 -->|No| E4[Wait in Queue]
        E4 --> E3
        E3 -->|Yes| E5[Reserve Power]
        E5 --> E6[Log Available Power]
        E6 --> E7([Return - Power Granted])
        
        E10[Release Power] --> E11[Container.put power_kw]
        E11 --> E12[Log Available Power]
        E12 --> E13([Return - Power Released])
        
        E20[Get Energy Price] --> E21[Query DataProvider]
        E21 --> E22([Return Price per kWh])
    end

    subgraph Events["Events & Signals"]
        EV1[arrival_event<br/>ChargingColumn] -.->|Signaled by Vehicle| EV2[Vehicle connects]
        EV3[request_disconnect<br/>Vehicle] -.->|Signaled by Vehicle| EV4[Vehicle wants to leave]
        EV5[request_disconnect_approved<br/>Vehicle] -.->|Signaled by Column| EV6[Column approves disconnect]
        EV7[charge_cmpt_event<br/>Vehicle] -.->|Signaled by Column| EV8[Charging complete]
    end

    subgraph Resources["Resources & Stores"]
        R1[ChargingColumn<br/>simpy.Resource<br/>capacity = n_ports]
        R2[EnergySandbox.power_grid<br/>simpy.Container<br/>capacity = max_power]
    end

    style Setup fill:#e1f5ff
    style VehicleFlow fill:#fff4e1
    style ChargingColumnFCFS fill:#e8f5e9
    style ChargingColumnSHRD fill:#f3e5f5
    style HandshakeProcess fill:#ffe0b2
    style EnergySandboxFlow fill:#fce4ec
    style Events fill:#ffebee
    style Resources fill:#e0f2f1